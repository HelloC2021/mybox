+	int mouse_btn;
+	int sent_key;
 	int irq;
 	int remote_pwm_id;
 	int handle_cpu_id;
@@ -117,6 +134,61 @@ static int remotectl_keycode_lookup(struct rkxx_remotectl_drvdata *ddata)
 	return 0;
 }
 
+static bool rmc_key_is_mouse(int keycode)
+{
+	return ((keycode & 0xf000) == 0x1000);
+}
+
+static int rmc_dpad_code(int keycode)
+{
+	static const int dpad[4] = { KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT };
+
+	if (keycode < RMC_KEY_MOUSE_UP || keycode > RMC_KEY_MOUSE_RIGHT)
+		return 0;
+
+	return dpad[keycode - RMC_KEY_MOUSE_UP];
+}
+
+static void rmc_mouse_move(struct rkxx_remotectl_drvdata *ddata, int held)
+{
+	int dx = 0;
+	int dy = 0;
+
+	switch (held) {
+	case RMC_KEY_MOUSE_UP:
+		dy = -RMC_MOUSE_STEP;
+		break;
+	case RMC_KEY_MOUSE_DOWN:
+		dy = RMC_MOUSE_STEP;
+		break;
+	case RMC_KEY_MOUSE_LEFT:
+		dx = -RMC_MOUSE_STEP;
+		break;
+	case RMC_KEY_MOUSE_RIGHT:
+		dx = RMC_MOUSE_STEP;
+		break;
+	default:
+		return;
+	}
+
+	input_report_rel(ddata->input, REL_X, dx);
+	input_report_rel(ddata->input, REL_Y, dy);
+}
+
+static void rmc_key_release(struct rkxx_remotectl_drvdata *ddata)
+{
+	if (ddata->mouse_btn) {
+		input_event(ddata->input, EV_KEY, BTN_MIDDLE, 0);
+		ddata->mouse_btn = 0;
+	}
+	if (ddata->sent_key) {
+		input_event(ddata->input, EV_KEY, ddata->sent_key, 0);
+		ddata->sent_key = 0;
+	}
+	ddata->mouse_held = 0;
+	input_sync(ddata->input);
+}
