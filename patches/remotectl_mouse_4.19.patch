+/*
+ * Reserved keycodes (key_table values, never emitted as EV_KEY):
+ * interpreted by the driver for mouse-mode support.
+ */
+#define RMC_KEY_MOUSE_UP	0x1011
+#define RMC_KEY_MOUSE_DOWN	0x1012
+#define RMC_KEY_MOUSE_LEFT	0x1013
+#define RMC_KEY_MOUSE_RIGHT	0x1014
+#define RMC_KEY_MOUSE_OK	0x10c0
+#define RMC_KEY_MOUSE_TOGGLE	0x10f0
+#define RMC_MOUSE_STEP		10
+
+
 struct rkxx_remote_key_table {
 	int scancode;
 	int keycode;
@@ -67,6 +80,10 @@ struct rkxx_remotectl_drvdata {
